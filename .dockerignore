# Anything not needed to build or run the service. Keeps the build context
# small, the image small, and secrets out of layers.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
tests/
docs/
*.md
.env
.env.*
!.env.example
dist/
build/
*.egg-info/
